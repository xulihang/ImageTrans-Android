<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_language" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerSource"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="→"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />

            <Spinner
                android:id="@+id/spinnerTarget"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_translation_mode" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/modeMyMemory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_mymemory"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/modeOpenai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_openai"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/modeOriginal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_original"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/modeImagetrans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_imagetrans"
                android:textSize="15sp" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/serverSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_server_section" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_server_url" />

            <EditText
                android:id="@+id/editServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://192.168.1.10:51043"
                android:inputType="textUri"
                android:singleLine="true" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_display_name" />

            <EditText
                android:id="@+id/editDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="default"
                android:inputType="text"
                android:singleLine="true" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_password" />

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="password"
                android:inputType="textPassword"
                android:singleLine="true" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_render_mode" />

            <Spinner
                android:id="@+id/spinnerServerRender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_server_render_note" />

            <TextView
                style="@style/Note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_server_default_note" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mymemorySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mymemory_section" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mymemory_email" />

            <EditText
                android:id="@+id/editMyMemoryEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="name@example.com"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

            <TextView
                style="@style/Note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mymemory_note" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/openaiSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_openai_section" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_openai_url" />

            <EditText
                android:id="@+id/editOpenAiUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://api.deepseek.com/v1"
                android:inputType="textUri"
                android:singleLine="true" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_openai_key" />

            <EditText
                android:id="@+id/editOpenAiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="sk-..."
                android:inputType="textPassword"
                android:singleLine="true" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_model" />

            <EditText
                android:id="@+id/editOpenAiModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="deepseek-flash"
                android:inputType="text"
                android:singleLine="true" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_openai_prompt" />

            <EditText
                android:id="@+id/editOpenAiPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="5"
                android:textSize="14sp" />

            <TextView
                style="@style/Note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_openai_prompt_note" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_render_section" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_render_css" />

        <EditText
            android:id="@+id/editRenderCss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="text-align: center; border-radius: 10%;"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/checkVertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_vertical_text"
            android:textSize="15sp" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_min_font" />

        <EditText
            android:id="@+id/editMinFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="14"
            android:inputType="number"
            android:singleLine="true" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_repair_mode" />

        <Spinner
            android:id="@+id/spinnerRepairMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_ja_detection" />

        <Spinner
            android:id="@+id/spinnerJaDetection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_css_note" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_ui_language" />

        <Spinner
            android:id="@+id/spinnerUiLang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnSave"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="@string/settings_save" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
