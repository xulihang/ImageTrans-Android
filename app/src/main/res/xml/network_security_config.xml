<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Allow plain HTTP for a server on the local network and trust user-installed
      certificates, so a self-signed ImageTrans server certificate can be added
      through Android's certificate settings.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
