    <string name="settings_prompt_needs_texts">提示词必须包含 {texts} 占位符</string>
    <string name="settings_openai_extra_params">额外参数（JSON）</string>
    <string name="settings_openai_extra_params_note">附加到每次翻译请求里的字段，默认关闭 DeepSeek 的思考：{"thinking": {"type": "disabled"}}。留空表示不加。model 和 messages 由应用设置，不能在这里覆盖。</string>
